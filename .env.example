# ── 대화 상대 AI: Google Gemini Live ─────────────────────────────
# Google AI Studio 에서 만든 Gemini API 키. 비우면 대화 AI만 가짜 응답(MOCK)으로 동작해요.
GEMINI_API_KEY=
CHAT_MODEL=gemini-3.8-live
# AI 발화 음성: live = Gemini Live 가 만든 음성 재생 (실패하면 브라우저 음성) / browser = 브라우저 내장 음성만
AI_VOICE=live
# Gemini Live 음성 이름 (비우면 기본 음성)
LIVE_VOICE=

# ── 피드백 · 점수 · Delayed 요약: OpenAI ─────────────────────────
# OpenAI API 키. 비우면 피드백만 가짜 응답(MOCK)으로 동작해요.
OPENAI_API_KEY=
FEEDBACK_MODEL=gpt-5-mini
# 추론 강도: none / low / medium / high / xhigh (높을수록 정확하지만 느리고 비쌈)
FEEDBACK_REASONING_EFFORT=low

# ── 학습자 발화 전사 ───────────────────────────────────────────
# browser = 브라우저 내장 음성 인식(Chrome, 말하는 동안 실시간 표시)
# whisper = 녹음 파일을 OpenAI Whisper 로 전사 (말하는 동안은 브라우저 인식으로 미리보기만, OPENAI_API_KEY 사용)
STT_ENGINE=whisper
WHISPER_MODEL=whisper-1
# browser 일 때만: 1이면 음성 인식이 잘못 받아 적은 단어만 가볍게 다듬어서 저장·표시·피드백에 사용 (학습자 오류는 그대로 둠)
STT_CLEANUP=0
STT_CLEANUP_MODEL=gpt-4o-mini

# 1이면 키가 있어도 둘 다 가짜 응답으로 동작 (화면·흐름 점검용)
MOCK_LLM=0

HOST=127.0.0.1
PORT=8000
